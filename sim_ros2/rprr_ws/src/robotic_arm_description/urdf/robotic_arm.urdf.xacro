<?xml version="1.0"?>
<robot name="robotic_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find robotic_arm_description)/urdf/macros.xacro"/>

  <!-- ===== common properties ===== -->
  <xacro:property name="mesh_path" value="package://robotic_arm_description/meshes"/>
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- ===== materials ===== -->
  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.9 0.1 0.1 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.1 0.8 0.1 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.1 0.3 0.9 1.0"/>
  </material>

  <material name="yellow">
    <color rgba="0.9 0.8 0.1 1.0"/>
  </material>

  <!-- ===== links ===== -->
  <link name="world"/>

  <xacro:mesh_link_cylinder
    name="base_link"
    mesh="${mesh_path}/robotic_base.STL"
    xyz="0 0 0"
    rpy="0 0 0"
    material="gray"
    scale="${mesh_scale}"
    mass="45.03725"
    com_xyz="0 0 -0.04506"
    ixx="0.28202210726"
    ixy="0.0"
    ixz="0.0"
    iyy="0.28202210726"
    iyz="0.0"
    izz="0.51527199205"
    collision_xyz="0 0 -0.042"
    collision_rpy="0 0 0"
    collision_radius="0.15"
    collision_length="0.084"/>

  <xacro:mesh_link_cylinder
    name="link1"
    mesh="${mesh_path}/robotic_link1.STL"
    xyz="0 0 0"
    rpy="0 0 0"
    material="red"
    scale="${mesh_scale}"
    mass="5.91726"
    com_xyz="0 0 -0.06624"
    ixx="0.15474082399"
    ixy="0.0"
    ixz="0.0"
    iyy="0.15474082399"
    iyz="0.0"
    izz="0.01090799225"
    collision_xyz="0 0 -0.1275"
    collision_rpy="0 0 0"
    collision_radius="0.09"
    collision_length="0.16"/>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/robotic_link2.STL" scale="${mesh_scale}"/>
      </geometry>
      <material name="green"/>
    </visual>

    <!-- Collision 1: hộp ngang -->
    <collision>
      <origin xyz="-0.125 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <box size="0.25 0.04 0.055"/>
      </geometry>
    </collision>

    <!-- Collision 2: trụ ngang -->
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.10"/>
      </geometry>
    </collision>

    <!-- Collision 3: trụ đứng phi 70, cao 75 mm ở đầu link2 -->
    <collision>
      <origin xyz="-0.25 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.075"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.0871 0 0.02104" rpy="0 0 0"/>
      <mass value="2.81241"/>
      <inertia
        ixx="0.00468338508"
        ixy="0.0000000071"
        ixz="0.00517658379"
        iyy="0.03089510989"
        iyz="0.00000000722"
        izz="0.02785620688"/>
    </inertial>
  </link>

  <xacro:mesh_link_box
    name="link3"
    mesh="${mesh_path}/robotic_link3.STL"
    xyz="0 0 0"
    rpy="0 0 0"
    material="blue"
    scale="${mesh_scale}"
    mass="0.47967"
    com_xyz="0 -0.00053 0.0354"
    ixx="0.00095902833"
    ixy="-0.00000000039"
    ixz="0.00000000049"
    iyy="0.00102455363"
    iyz="0.00000953707"
    izz="0.00019715797"
    collision_xyz="0 0 0.0635"
    collision_rpy="0 -1.5708 0"
    collision_size="0.11 0.045 0.045"/>

  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_path}/robotic_endeffector_welding.STL" scale="${mesh_scale}"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <origin xyz="0 0 -0.0675" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.135"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.08"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="-0.038 0 0.1035" rpy="0 -0.92 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.075"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.00226 0 -0.04753" rpy="0 0 0"/>
      <mass value="0.23944"/>
      <inertia
        ixx="0.00083897742"
        ixy="0.0"
        ixz="-0.00008675625"
        iyy="0.00086919822"
        iyz="0.0"
        izz="0.00004375907"/>
    </inertial>
  </link>

  <!-- ===== joints ===== -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.084" rpy="0 0 0"/>
  </joint>

  <xacro:revolute_joint
    name="q1"
    parent="base_link"
    child="link1"
    xyz="0 0 0.2175"
    rpy="0 0 0"
    axis="0 0 1"
    lower="${-pi}"
    upper="${pi}"
    effort="10"
    velocity="0.5"/>

  <xacro:prismatic_joint
    name="q2"
    parent="link1"
    child="link2"
    xyz="0.25 0 0"
    rpy="${pi/2} 0 0"
    axis="0 1 0"
    lower="0.0"
    upper="0.225"
    effort="10000"
    velocity="0.4"/>

  <xacro:revolute_joint
    name="q3"
    parent="link2"
    child="link3"
    xyz="0 0 0.105"
    rpy="${pi/2} 0 ${pi/2}"
    axis="0 1 0"
    lower="${-pi/2}"
    upper="${3*pi/4}"
    effort="50"
    velocity="0.5"/>

  <xacro:revolute_joint
    name="q4"
    parent="link3"
    child="end_effector"
    xyz="0 0 0.262"
    rpy="0 0 0"
    axis="0 0 1"
    lower="${-pi}"
    upper="${pi}"
    effort="20"
    velocity="0.8"/>

</robot>
